{
  "name": "prompt-eval",
  "version": "1.0.0",
  "description": "Evaluate models using promptfoo",
  "private": true,
  "scripts": {
    "test": "node --test test/",
    "check-sync": "node scripts/sync-prompts.js --check",
    "sync-prompts": "node scripts/sync-prompts.js",
    "vocabulary-translation": "promptfoo eval -c vocabulary-translation/promptfooconfig.yaml",
    "vocabulary-translation:smoke": "SMOKE=1 promptfoo eval -c vocabulary-translation/promptfooconfig.yaml",
    "models-item": "promptfoo eval -c models-item/promptfooconfig.yaml",
    "models-item:smoke": "SMOKE=1 promptfoo eval -c models-item/promptfooconfig.yaml",
    "correction-vocabulary": "promptfoo eval -c correction/vocabulary.yaml",
    "correction-vocabulary:smoke": "SMOKE=1 promptfoo eval -c correction/vocabulary.yaml",
    "correction-models": "promptfoo eval -c correction/models.yaml",
    "correction-models:smoke": "SMOKE=1 promptfoo eval -c correction/models.yaml",
    "generate-translation": "promptfoo eval -c generate/translation.yaml",
    "generate-translation:smoke": "SMOKE=1 promptfoo eval -c generate/translation.yaml",
    "generate-transcription": "promptfoo eval -c generate/transcription.yaml",
    "generate-transcription:smoke": "SMOKE=1 promptfoo eval -c generate/transcription.yaml",
    "generate-title": "promptfoo eval -c generate/title.yaml",
    "generate-title:smoke": "SMOKE=1 promptfoo eval -c generate/title.yaml",
    "generate-processText": "promptfoo eval -c generate/processText.yaml",
    "generate-processText:smoke": "SMOKE=1 promptfoo eval -c generate/processText.yaml",
    "generate-processDialog": "promptfoo eval -c generate/processDialog.yaml",
    "generate-processDialog:smoke": "SMOKE=1 promptfoo eval -c generate/processDialog.yaml",
    "generate-generateVocabulary": "promptfoo eval -c generate/generateVocabulary.yaml",
    "generate-generateVocabulary:smoke": "SMOKE=1 promptfoo eval -c generate/generateVocabulary.yaml",
    "generate-generateModels": "promptfoo eval -c generate/generateModels.yaml",
    "generate-generateModels:smoke": "SMOKE=1 promptfoo eval -c generate/generateModels.yaml",
    "view": "promptfoo view"
  },
  "type": "commonjs",
  "devDependencies": {
    "promptfoo": "^0.123.1",
    "yaml": "^2.9.1"
  }
}
